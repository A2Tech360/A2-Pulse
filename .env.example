GOOGLE_MAPS_API_KEY=
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_flash_v2_5

# ---- LLM (optional) ---------------------------------------------------------
# Leave LLM_MODEL unset (or set it to off) to run on the built-in heuristics and
# templates (no LLM calls at all). To turn the LLM on, uncomment LLM_MODEL below
# and set that provider's key.
# LLM_MODEL uses LiteLLM model names ("provider/model", or a bare OpenAI /
# Anthropic name), for example:
#   gpt-4o-mini                      -> needs OPENAI_API_KEY
#   claude-haiku-4-5                 -> needs ANTHROPIC_API_KEY
#   gemini/gemini-2.0-flash          -> needs GEMINI_API_KEY (or GOOGLE_API_KEY)
#   groq/llama-3.1-8b-instant        -> needs GROQ_API_KEY
#   mistral/mistral-small-latest     -> needs MISTRAL_API_KEY
#   ollama/llama3.1                  -> no key, local Ollama daemon
# LLM_API_KEY, if set, is used for any provider instead of the named key.
# LLM_API_BASE points at an OpenAI-compatible gateway (then LLM_MODEL is
# "openai/<model>" and LLM_API_KEY is the gateway's token).
# Each call has an 8-second deadline and falls back to the templates on failure.
# LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# LLM_API_KEY=
# LLM_API_BASE=
# Set to 1 to enable the llm_status diagnostic endpoint (off by default).
# DEBUG_LLM=
